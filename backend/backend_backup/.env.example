# CyberSentinel Backend Config
PORT=3000
MONGO_URI=mongodb://localhost:27017/cybersentinel
# For production with auth: mongodb://sentinel:password@localhost:27017/cybersentinel?authSource=cybersentinel

# Suricata EVE JSON path
EVE_JSON_PATH=/var/log/suricata/eve.json
# For mock/demo without Suricata installed, use local file:
# EVE_JSON_PATH=../suricata/eve.json

# Mode: real (tail /var/log/suricata/eve.json) or mock (use sample file)
EVE_MODE=real

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# LLM for AI Analysis (OpenAI compatible)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Or use Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1

# Security Score
INITIAL_SECURITY_SCORE=100

# Demo assets (seed on first run)
SEED_DB=true
